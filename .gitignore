# ==========================================
# 1. DEPENDENCIES
# ==========================================
# Ignores frontend/node_modules & backend/node_modules
node_modules/
.pnp
.pnp.js

# ==========================================
# 2. NEXT.JS BUILD & CACHE (FRONTEND)
# ==========================================
frontend/.next/
frontend/out/
frontend/build/
.swc/

# ==========================================
# 3. NODE.JS BUILD & OUTPUTS (BACKEND)
# ==========================================
backend/dist/
backend/build/
*.tsbuildinfo

# ==========================================
# 4. ENVIRONMENT VARIABLES & SECRETS
# ==========================================
# Ignores .env, .env.local, .env.production, etc., anywhere
.env
.env.*
!.env.example

# ==========================================
# 5. LOGS & DEBUGGING
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 6. SYSTEM & EDITOR FILES
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ==========================================
# 7. VERCEL & DEPLOYMENT CACHES
# ==========================================
.vercel/
# ==========================================
# NEXT.JS PWA & SERVICE WORKERS
# ==========================================
# Auto-generated service worker files in public folder
frontend/public/sw.js
frontend/public/sw.js.map
frontend/public/workbox-*.js
frontend/public/workbox-*.js.map
frontend/public/worker-*.js
frontend/public/worker-*.js.map
frontend/public/fallback-*.js

# PWA cache files generated during build
frontend/.next/cache/